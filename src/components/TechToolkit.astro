---
import Icon from './Icon.astro';
import {
    siDotnet,
    siTypescript,
    siReact,
    siGo,
    siRust,
    siDocker,
    siKubernetes,
    siTerraform,
    siGithubactions,
    siSonarqubeserver,
    siTeamcity,
    siOctopusdeploy,
    siGithubcopilot,
    siClaude,
    siModelcontextprotocol,
} from 'simple-icons';

interface TechItem {
    name: string;
    svgPath?: string;
    hex?: string;
    /** Per-theme logo colour where the brand colour is too faint on that background */
    lightHex?: string;
    darkHex?: string;
    /** Letters for the text tile when there is no logo; defaults to the first two of the name */
    abbr?: string;
}

function logoColors(item: TechItem): string | undefined {
    if (!item.hex || isNearBlack(item.hex)) {
        return undefined;
    }
    return `--logo-light: #${item.lightHex ?? item.hex}; --logo-dark: #${item.darkHex ?? item.hex}`;
}

/** Near-black brand colours (Copilot, MCP, TeamCity, Rust) vanish on the dark theme background. */
function isNearBlack(hex: string): boolean {
    const channel = (i: number) => parseInt(hex.slice(i, i + 2), 16) / 255;
    const luminance = 0.2126 * channel(0) + 0.7152 * channel(2) + 0.0722 * channel(4);
    return luminance < 0.1;
}

interface Category {
    label: string;
    icon: 'code' | 'rocket-launch' | 'strategy' | 'shield-check' | 'terminal-window' | 'star';
    items: TechItem[];
}

const categories: Category[] = [
    {
        label: 'AI-Assisted Engineering',
        icon: 'terminal-window',
        items: [
            { name: 'GitHub Copilot', svgPath: siGithubcopilot.path, hex: siGithubcopilot.hex },
            { name: 'Copilot CLI', svgPath: siGithubcopilot.path, hex: siGithubcopilot.hex },
            { name: 'Claude Code', svgPath: siClaude.path, hex: siClaude.hex },
            { name: 'Claude Skills', svgPath: siClaude.path, hex: siClaude.hex },
            // Practices rather than products, so they keep a text tile
            { name: 'Context Engineering', hex: '1e4db7', abbr: 'CE' },
            {
                name: 'MCP',
                svgPath: siModelcontextprotocol.path,
                hex: siModelcontextprotocol.hex,
            },
            { name: 'Agentic Workflows', hex: '1e4db7', abbr: 'AW' },
        ],
    },
    {
        label: 'Languages & Frameworks',
        icon: 'code',
        items: [
            { name: 'C# / .NET', svgPath: siDotnet.path, hex: siDotnet.hex, darkHex: '9B87F5' },
            // simple-icons has no Microsoft logos, so those use text tiles
            { name: '.NET Aspire', hex: '512BD4', abbr: 'AS' },
            { name: 'TypeScript', svgPath: siTypescript.path, hex: siTypescript.hex },
            // React and Go use these darker brand shades on light backgrounds themselves
            { name: 'React', svgPath: siReact.path, hex: siReact.hex, lightHex: '087EA4' },
            { name: 'PowerShell', hex: '012456', abbr: 'PS' },
            { name: 'SQL', hex: '1e4db7', abbr: 'SQ' },
        ],
    },
    {
        label: 'Cloud & Infrastructure',
        icon: 'rocket-launch',
        items: [
            { name: 'Azure', hex: '0078D4' },
            { name: 'Azure Functions', hex: '0078D4', abbr: 'FN' },
            { name: 'Service Bus', hex: '0078D4', abbr: 'SB' },
            { name: 'Cosmos DB', hex: '0078D4', abbr: 'DB' },
            { name: 'Bicep', hex: '0078D4' },
            { name: 'Terraform', svgPath: siTerraform.path, hex: siTerraform.hex },
            { name: 'Docker', svgPath: siDocker.path, hex: siDocker.hex },
        ],
    },
    {
        label: 'Architecture',
        icon: 'strategy',
        items: [
            { name: 'Microservices' },
            { name: 'Event-Driven' },
            { name: 'Domain-Driven Design' },
            { name: 'Cloud-Native' },
            { name: 'Enterprise Integration' },
            { name: 'REST & gRPC APIs' },
            { name: 'Legacy Modernization' },
        ],
    },
    {
        label: 'Delivery & Quality',
        icon: 'shield-check',
        items: [
            { name: 'GitHub Actions', svgPath: siGithubactions.path, hex: siGithubactions.hex },
            { name: 'Azure DevOps', hex: '0078D4', abbr: 'DO' },
            { name: 'TeamCity', svgPath: siTeamcity.path, hex: siTeamcity.hex },
            { name: 'Octopus Deploy', svgPath: siOctopusdeploy.path, hex: siOctopusdeploy.hex },
            { name: 'SonarQube', svgPath: siSonarqubeserver.path, hex: siSonarqubeserver.hex },
            { name: 'Fortify', hex: '1e4db7', abbr: 'FO' },
        ],
    },
    {
        // Interest, not production experience: kept apart so it isn't read as the same depth
        label: 'Currently Exploring',
        icon: 'star',
        items: [
            { name: 'Go', svgPath: siGo.path, hex: siGo.hex, lightHex: '007D9C' },
            { name: 'Rust', svgPath: siRust.path, hex: siRust.hex },
            { name: 'Kubernetes', svgPath: siKubernetes.path, hex: siKubernetes.hex },
        ],
    },
];
---

<section class="toolkit-grid">
    {categories.map(cat => (
        <div class="category">
            <header class="category-header">
                <Icon icon={cat.icon} size="1.4em" color="var(--accent-regular)" />
                <h3>{cat.label}</h3>
            </header>
            <ul class="item-list">
                {cat.items.map(item => (
                    <li class="tech-item">
                        {item.svgPath ? (
                            <svg
                                viewBox="0 0 24 24"
                                aria-hidden="true"
                                data-logo={item.name}
                                class:list={[
                                    'tech-icon',
                                    { mono: item.hex && isNearBlack(item.hex) },
                                ]}
                                style={logoColors(item)}
                            >
                                <path d={item.svgPath} fill="currentColor" />
                            </svg>
                        ) : (
                            // Concepts without a brand colour (Architecture) get no tile: white
                            // initials on no background were invisible on the light theme
                            item.hex && (
                                <span
                                    class="tech-icon text-icon"
                                    style={`background: #${item.hex}`}
                                    aria-hidden="true"
                                >
                                    {item.abbr ?? item.name.slice(0, 2).toUpperCase()}
                                </span>
                            )
                        )}
                        <span class="tech-name">{item.name}</span>
                    </li>
                ))}
            </ul>
        </div>
    ))}
</section>

<style>
    .toolkit-grid {
        display: grid;
        gap: 2.5rem;
        grid-template-columns: 1fr;
    }

    .category {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .category-header {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding-bottom: 0.6rem;
        border-bottom: 1px solid var(--gray-800);
    }

    .category-header h3 {
        font-size: var(--text-lg);
        color: var(--gray-0);
        font-weight: 600;
    }

    .item-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .tech-item {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.35rem 0.75rem 0.35rem 0.55rem;
        background: var(--gray-999_40);
        border: 1px solid var(--gray-800);
        border-radius: 999rem;
        transition: border-color var(--theme-transition);
    }

    .tech-item:hover {
        border-color: var(--gray-600);
    }

    .tech-icon {
        width: 1rem;
        height: 1rem;
        flex-shrink: 0;
        color: var(--logo-light);
    }

    :global(.theme-dark) .tech-icon {
        color: var(--logo-dark);
    }

    /* Near-black logos follow the text colour: dark on light, white on dark */
    .tech-icon.mono,
    :global(.theme-dark) .tech-icon.mono {
        color: var(--gray-0);
    }

    .text-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 3px;
        font-size: 0.5rem;
        font-weight: 700;
        color: #fff;
        letter-spacing: -0.02em;
    }

    .tech-name {
        font-size: var(--text-sm);
        color: var(--gray-200);
        white-space: nowrap;
    }

    @media (min-width: 50em) {
        .toolkit-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 3rem;
        }
    }
</style>
