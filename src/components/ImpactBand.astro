---
interface Props {
    yearsOfExperience: number;
}

const { yearsOfExperience } = Astro.props;

interface Stat {
    value: string;
    label: string;
    detail: string;
}

const stats: Stat[] = [
    {
        value: `${yearsOfExperience}+`,
        label: 'Years in the trenches',
        detail: 'Engineering and leading enterprise systems since 2009',
    },
    {
        value: '£150M+',
        label: 'Contracts secured',
        detail: 'Multi-year UK government deals won on solutions I engineered at KPMG',
    },
    {
        value: '40+',
        label: 'Engineers led',
        detail: 'Across DevOps, Data, QA and Software, coaching juniors to senior and tech leads to agentic coding',
    },
    {
        // Matches the industries strip in CareerTimeline.astro
        value: '5',
        label: 'Industries served',
        detail: 'Aviation, energy, finance, government and professional services',
    },
];
---

<section class="impact" aria-label="Impact at a glance">
    <ul class="impact-grid">
        {stats.map(stat => (
            <li class="stat">
                <span class="stat-value">{stat.value}</span>
                <span class="stat-label">{stat.label}</span>
                <span class="stat-detail">{stat.detail}</span>
            </li>
        ))}
    </ul>
</section>

<style>
    .impact {
        width: 100%;
    }

    .impact-grid {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        /* minmax(0, 1fr) keeps columns equal; plain 1fr grows to fit the widest number */
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1px;
        background: var(--gray-800);
        border: 1px solid var(--gray-800);
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
    }

    .stat {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        padding: 1.6rem 1rem;
        background: var(--gray-999);
        transition: background var(--theme-transition);
    }

    .stat-value {
        font-family: var(--font-brand);
        /* Scales with the viewport so the widest value (£150M+) fits a half-width tile */
        font-size: clamp(1.5rem, 7.5vw, var(--text-3xl));
        font-weight: 700;
        line-height: 1;
        width: fit-content;
        background: var(--gradient-accent);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .stat-label {
        font-weight: 600;
        color: var(--gray-0);
        font-size: var(--text-md);
    }

    .stat-detail {
        font-size: var(--text-sm);
        color: var(--gray-400);
        line-height: 1.45;
    }

    @media (min-width: 50em) {
        .stat {
            padding: 2.25rem 2rem;
        }

        .stat-value {
            font-size: var(--text-4xl);
        }
    }

    /* Four across only once the widest value (£150M+) fits a quarter-width tile */
    @media (min-width: 64em) {
        .impact-grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }

        .stat-value {
            font-size: clamp(2.5rem, 4.4vw, var(--text-4xl));
        }
    }
</style>
