---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import type { Props as IconProps } from './Icon.astro';

const engagements: CollectionEntry<'engagement'>[] = (await getCollection('engagement')).sort(
    (a: CollectionEntry<'engagement'>, b: CollectionEntry<'engagement'>) =>
        b.data.startDate.valueOf() - a.data.startDate.valueOf()
);

const now = new Date();

function formatYear(d: Date) {
    return d.getFullYear().toString();
}

function formatDuration(startDate: Date, endDate: Date): string {
    const effectiveEndDate = endDate > now ? now : endDate;
    const totalMonths =
        (effectiveEndDate.getFullYear() - startDate.getFullYear()) * 12 +
        (effectiveEndDate.getMonth() - startDate.getMonth());
    const years = Math.floor(totalMonths / 12);
    const months = totalMonths % 12;
    const parts: string[] = [];
    if (years > 0) parts.push(`${years} yr${years !== 1 ? 's' : ''}`);
    if (months > 0) parts.push(`${months} mo`);
    return parts.join(' ') || '< 1 mo';
}

function isCurrent(endDate: Date): boolean {
    const diff =
        now.getFullYear() * 12 + now.getMonth() - endDate.getFullYear() * 12 - endDate.getMonth();
    return diff <= 3;
}

function endLabel(endDate: Date): string {
    return isCurrent(endDate) ? 'Present' : formatYear(endDate);
}

function isFreelance(employment: string): boolean {
    return employment.toLowerCase().includes('freelan');
}

// Trim the long sector descriptors down to a compact industry label.
function sectorLabel(title: string): string {
    return title.replace(/\s+(Sector|Services)$/i, '').trim();
}

// Distinct industries across the whole career, for the breadth strip.
const industries: { icon: IconProps['icon']; label: string }[] = [
    { icon: 'airplane-tilt', label: 'Aviation' },
    { icon: 'lightning', label: 'Energy' },
    { icon: 'building-office', label: 'Finance' },
    { icon: 'shield-check', label: 'Government' },
    { icon: 'cpu', label: 'Professional Services' },
];
---

<section class="timeline">
    <header class="timeline-head">
        <div class="timeline-head-text">
            <h2>Career at a glance</h2>
            <p>
                Seventeen years across regulated, high-stakes industries, from oil &amp; gas to
                aviation and government.
            </p>
        </div>
        <ul class="industries" aria-label="Industries worked in">
            {industries.map(industry => (
                <li class="industry">
                    <Icon icon={industry.icon} size="0.95em" />
                    {industry.label}
                </li>
            ))}
        </ul>
    </header>

    <ul class="timeline-list">
        {engagements.map(engagement => (
            <li
                class:list={['timeline-item', { 'is-current': isCurrent(engagement.data.endDate) }]}
            >
                <div class="timeline-link">
                    <span class="year-range">
                        <span class="year-start">{formatYear(engagement.data.startDate)}</span>
                        <span class="year-end">{endLabel(engagement.data.endDate)}</span>
                    </span>
                    <span class="role-info">
                        <span class="role-head">
                            <span class="role-title">{engagement.data.position}</span>
                            {isFreelance(engagement.data.employment) && (
                                <span class="freelance-badge">Freelance</span>
                            )}
                            {engagement.data.caseStudy && (
                                <a class="case-study-link" href={`/engagements/${engagement.id}`}>
                                    Case study →
                                </a>
                            )}
                        </span>
                        {engagement.data.mission && (
                            <span class="mission">{engagement.data.mission}</span>
                        )}
                        <span class="role-meta">
                            <span class="sector">
                                <Icon
                                    icon={engagement.data.sectorIcon}
                                    title={engagement.data.sectorTitle}
                                    size="0.85em"
                                />
                                {sectorLabel(engagement.data.sectorTitle)}
                            </span>
                            <span class="dot" aria-hidden="true">
                                ·
                            </span>
                            <span class="employer">{engagement.data.employer}</span>
                            <span class="dot" aria-hidden="true">
                                ·
                            </span>
                            <span class="location">{engagement.data.location}</span>
                            <span class="dot" aria-hidden="true">
                                ·
                            </span>
                            <span class="duration">
                                {formatDuration(engagement.data.startDate, engagement.data.endDate)}
                            </span>
                        </span>
                    </span>
                </div>
            </li>
        ))}
    </ul>
</section>

<style>
    .timeline {
        width: 100%;
    }

    /* Header + industry breadth strip */
    .timeline-head {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        margin-bottom: 2rem;
    }

    .timeline-head h2 {
        font-size: var(--text-xl);
        color: var(--gray-0);
    }

    .timeline-head-text p {
        margin-top: 0.4rem;
        color: var(--gray-400);
        font-size: var(--text-sm);
        max-width: 48ch;
    }

    .industries {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .industry {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: var(--text-xsm);
        font-weight: 500;
        color: var(--gray-200);
        padding: 0.3rem 0.75rem;
        border: 1px solid var(--gray-800);
        border-radius: 999rem;
        background: var(--gray-999_40);
    }

    /* Timeline rail */
    .timeline-list {
        list-style: none;
        padding: 0;
        margin: 0;
        border-left: 2px solid var(--gray-800);
        padding-left: 1.75rem;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .timeline-item {
        position: relative;
    }

    /* Timeline node */
    .timeline-item::before {
        content: '';
        position: absolute;
        left: -1.875rem;
        top: 1.35rem;
        width: 0.6rem;
        height: 0.6rem;
        border-radius: 50%;
        background: var(--gray-700);
        border: 2px solid var(--gray-999);
        transition: background var(--theme-transition);
        z-index: 1;
    }

    .timeline-item.is-current::before {
        background: var(--accent-regular);
        box-shadow: 0 0 0 4px var(--accent-subtle-overlay);
    }

    .timeline-link {
        display: flex;
        align-items: flex-start;
        gap: 1.25rem;
        padding: 1rem 0.85rem;
        border-radius: 0.75rem;
    }

    .year-range {
        display: flex;
        flex-direction: column;
        font-variant-numeric: tabular-nums;
        min-width: 3.5rem;
        flex-shrink: 0;
        padding-top: 0.15rem;
    }

    .year-start {
        font-size: var(--text-md);
        font-weight: 600;
        color: var(--gray-100);
    }

    .year-end {
        font-size: var(--text-sm);
        color: var(--gray-400);
    }

    .is-current .year-end {
        color: var(--accent-regular);
        font-weight: 600;
    }

    .role-info {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        min-width: 0;
    }

    .role-head {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.6rem;
    }

    .role-title {
        font-weight: 600;
        color: var(--gray-0);
        font-size: var(--text-md);
        transition: color var(--theme-transition);
    }

    .mission {
        color: var(--gray-300);
        font-size: var(--text-sm);
        line-height: 1.45;
    }

    .role-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.3rem 0.5rem;
        font-size: var(--text-xsm);
        color: var(--gray-400);
    }

    .sector {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        color: var(--gray-300);
        font-weight: 500;
    }

    .dot {
        opacity: 0.4;
    }

    .freelance-badge {
        font-size: var(--text-xsm);
        padding: 0.05rem 0.5rem;
        border-radius: 999rem;
        border: 1px solid var(--accent-regular);
        color: var(--accent-regular);
        font-weight: 500;
        line-height: 1.5;
    }

    .case-study-link {
        font-size: var(--text-xsm);
        font-weight: 600;
        color: var(--accent-regular);
        text-decoration: none;
        white-space: nowrap;
    }

    .case-study-link:hover {
        text-decoration: underline;
    }

    @media (min-width: 50em) {
        .timeline-head {
            flex-direction: row;
            align-items: flex-end;
            justify-content: space-between;
            gap: 2rem;
        }

        .industries {
            justify-content: flex-end;
            max-width: 32rem;
        }

        .year-range {
            min-width: 4rem;
        }
    }
</style>
