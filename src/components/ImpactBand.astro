---
interface Props {
    yearsOfExperience: number;
}

const { yearsOfExperience } = Astro.props;

interface Stat {
    value: string;
    label: string;
    detail: string;
}

const stats: Stat[] = [
    {
        value: `${yearsOfExperience}+`,
        label: 'Years in the trenches',
        detail: 'Engineering and leading enterprise systems since 2009',
    },
    {
        value: '£150M+',
        label: 'Contracts secured',
        detail: 'Multi-year UK government deals won on solutions I engineered at KPMG',
    },
    {
        value: '40+',
        label: 'Engineers led',
        detail: 'Globally distributed, across DevOps, Data, QA and Software',
    },
    {
        value: '6',
        label: 'Critical roles covered',
        detail: 'Tech lead, architect, QE & production owner, stepped into at Transavia when teams needed it',
    },
];
---

<section class="impact" aria-label="Impact at a glance">
    <ul class="impact-grid">
        {stats.map(stat => (
            <li class="stat">
                <span class="stat-value">{stat.value}</span>
                <span class="stat-label">{stat.label}</span>
                <span class="stat-detail">{stat.detail}</span>
            </li>
        ))}
    </ul>
</section>

<style>
    .impact {
        width: 100%;
    }

    .impact-grid {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1px;
        background: var(--gray-800);
        border: 1px solid var(--gray-800);
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
    }

    .stat {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        padding: 1.6rem 1.4rem;
        background: var(--gray-999);
        transition: background var(--theme-transition);
    }

    .stat-value {
        font-family: var(--font-brand);
        font-size: var(--text-3xl);
        font-weight: 700;
        line-height: 1;
        width: fit-content;
        background: var(--gradient-accent);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .stat-label {
        font-weight: 600;
        color: var(--gray-0);
        font-size: var(--text-md);
    }

    .stat-detail {
        font-size: var(--text-sm);
        color: var(--gray-400);
        line-height: 1.45;
    }

    @media (min-width: 50em) {
        .impact-grid {
            grid-template-columns: repeat(4, 1fr);
        }

        .stat {
            padding: 2.25rem 2rem;
        }

        .stat-value {
            font-size: var(--text-4xl);
        }
    }
</style>
