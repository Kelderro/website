---
import type { CollectionEntry } from 'astro:content';
import Icon from '../components/Icon.astro';

interface Props {
    engagement: CollectionEntry<'engagement'>;
}

const { data, id } = Astro.props.engagement;

const now = new Date();

function formatPeriod(startDate: Date, endDate: Date): string {
    const effectiveEnd = endDate > now ? now : endDate;
    const totalMonths =
        (effectiveEnd.getFullYear() - startDate.getFullYear()) * 12 +
        (effectiveEnd.getMonth() - startDate.getMonth());
    const years = Math.floor(totalMonths / 12);
    const months = totalMonths % 12;
    const parts: string[] = [];
    if (years > 0) parts.push(`${years} yr${years !== 1 ? 's' : ''}`);
    if (months > 0) parts.push(`${months} mo`);
    const duration = parts.length ? ` · ${parts.join(' ')}` : '';

    const fmt = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
    return `${fmt(startDate)} – ${fmt(endDate)}${duration}`;
}

// Impact is authored as a Markdown bullet list in frontmatter.
const impactItems = (data.impact ?? '')
    .split('\n')
    .map((line: string) => line.trim())
    .filter((line: string) => line.startsWith('- '))
    .map((line: string) => line.slice(2).trim());

const isCaseStudy = data.caseStudy === true;
---

<article class="card">
    <div class="card-inner">
        <div class="card-header">
            <span class="employer">{data.employer}</span>
            <span class="employment-type">{data.employment}</span>
        </div>
        <div class="role">{data.position}</div>
        {data.mission && <p class="mission">{data.mission}</p>}
        <div class="meta">
            <span>
                <Icon icon="calendar" size="0.9em" />
                {formatPeriod(data.startDate, data.endDate)}
            </span>
            <span>
                <Icon icon="map-pin" size="0.9em" />
                {data.location}
            </span>
        </div>
        {data.tags?.length && (
            <div class="tags">
                {data.tags.map((tag: string) => (
                    <span class="tag">{tag}</span>
                ))}
            </div>
        )}

        {isCaseStudy ? (
            <a class="card-cta" href={`/engagements/${id}`}>
                Read the full case study
                <Icon icon="arrow-right" size="1em" />
            </a>
        ) : (
            impactItems.length > 0 && (
                <details class="card-details">
                    <summary>
                        <span class="summary-label">Key impact</span>
                        <span class="summary-marker" aria-hidden="true">
                            +
                        </span>
                    </summary>
                    <ul class="impact-list">
                        {impactItems.map((item: string) => (
                            <li>{item}</li>
                        ))}
                    </ul>
                </details>
            )
        )}
    </div>
</article>

<style>
    .card {
        display: block;
        padding: 1.5rem;
        background: var(--gradient-subtle);
        border: 1px solid var(--gray-800);
        border-left: 3px solid var(--accent-regular);
        border-radius: 0.75rem;
        color: var(--gray-200);
        box-shadow: var(--shadow-sm);
        transition:
            box-shadow var(--theme-transition),
            border-left-color var(--theme-transition);
    }

    .card:hover {
        box-shadow: var(--shadow-md);
    }

    .card-inner {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .card-header {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 0.5rem;
    }

    .employer {
        font-size: var(--text-sm);
        font-weight: 600;
        color: var(--accent-regular);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .employment-type {
        font-size: var(--text-sm);
        color: var(--gray-400);
        border: 1px solid var(--gray-700);
        border-radius: 999rem;
        padding: 0.1rem 0.6rem;
        white-space: nowrap;
    }

    .role {
        font-weight: 600;
        font-family: var(--font-brand);
        font-size: var(--text-lg);
        color: var(--gray-0);
        line-height: 1.3;
    }

    .mission {
        font-size: var(--text-sm);
        color: var(--gray-200);
        line-height: 1.5;
    }

    .meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
        font-size: var(--text-sm);
        color: var(--gray-400);
    }

    .meta span {
        display: flex;
        align-items: center;
        gap: 0.3rem;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-top: 0.25rem;
    }

    .tag {
        font-size: 0.72rem;
        padding: 0.15rem 0.65rem;
        border-radius: 999rem;
        background: var(--accent-overlay);
        color: var(--accent-text-over);
        font-weight: 500;
    }

    /* Flagship case-study call to action */
    .card-cta {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: 0.5rem;
        font-size: var(--text-sm);
        font-weight: 600;
        color: var(--accent-regular);
        text-decoration: none;
        transition: gap var(--theme-transition);
    }

    .card-cta:hover {
        gap: 0.7rem;
    }

    /* Inline expandable impact for non-flagship roles */
    .card-details {
        margin-top: 0.5rem;
        border-top: 1px solid var(--gray-800);
        padding-top: 0.6rem;
    }

    .card-details summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        cursor: pointer;
        list-style: none;
        font-size: var(--text-sm);
        font-weight: 600;
        color: var(--gray-200);
    }

    .card-details summary::-webkit-details-marker {
        display: none;
    }

    .summary-label {
        color: var(--accent-regular);
        text-transform: uppercase;
        font-size: var(--text-xsm);
        letter-spacing: 0.08em;
    }

    .summary-marker {
        font-size: 1.1rem;
        line-height: 1;
        color: var(--gray-400);
        transition: transform var(--theme-transition);
    }

    .card-details[open] .summary-marker {
        transform: rotate(45deg);
    }

    .impact-list {
        margin: 0.75rem 0 0;
        padding-left: 1.1rem;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        font-size: var(--text-sm);
        color: var(--gray-300);
        line-height: 1.5;
    }

    @media (min-width: 50em) {
        .card {
            border-radius: 1rem;
        }
    }
</style>
